{
  "manifest_version": 3,
  "name": "Pomelo Tab",
  "version": "1.0.0",
  "description": "一个安静、快速、可自定义的新标签页。",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "tabs", "favicon", "bookmarks", "history", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
